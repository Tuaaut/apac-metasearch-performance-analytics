config {
  type: "table",
  schema: "apac_meta_silver",
  assertions: {
    uniqueKey: ["session_id"],
    nonNull: ["session_id", "user_id", "session_start_timestamp", "market", "device_type", "traffic_source", "is_new_user"],
    rowConditions: ["traffic_source IN ('paid_metasearch','organic')", "device_type IN ('mobile','desktop')"]
  }
}

SELECT
  session_id,
  user_id,
  SAFE_CAST(session_start_timestamp AS TIMESTAMP) AS session_start_timestamp,
  market,
  device_type,
  traffic_source,
  CASE WHEN is_new_user = '1' THEN TRUE WHEN is_new_user = '0' THEN FALSE ELSE NULL END AS is_new_user
FROM ${ref("user_sessions")}
