config {
  type: "table",
  schema: "apac_meta_silver",
  assertions: {
    uniqueKey: ["experiment_id", "experiment_group"],
    nonNull: ["experiment_id", "market", "channel", "experiment_group", "eligible_users", "conversions", "revenue"],
    rowConditions: ["experiment_group IN ('Treatment','Control')", "eligible_users > 0", "conversions BETWEEN 0 AND eligible_users", "revenue >= 0"]
  }
}

SELECT
  experiment_id,
  market,
  channel,
  experiment_group,
  SAFE_CAST(eligible_users AS INT64) AS eligible_users,
  SAFE_CAST(conversions AS INT64) AS conversions,
  SAFE_CAST(revenue AS NUMERIC) AS revenue
FROM ${ref("incrementality_experiment")}
