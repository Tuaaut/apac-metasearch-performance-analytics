table RefreshMetadata
	lineageTag: 4ad6e147-f6a4-56ce-acb6-82857d22f880

	measure 'Dataform Workflow State' = MAX(RefreshMetadata[dataform_workflow_state])
		formatString: @
		displayFolder: KPI Measures
		lineageTag: ab8fca08-e918-5ddf-b14b-0cea9e456ea6

	measure 'Data Through Date' = MAX(RefreshMetadata[data_through_date])
		formatString: mmm d, yyyy
		displayFolder: KPI Measures
		lineageTag: caa3d04e-ea8b-54c1-bce7-ea517a904579

	measure 'Snapshot Export UTC' = MAX(RefreshMetadata[snapshot_exported_utc])
		formatString: yyyy-mm-dd hh:mm:ss
		displayFolder: KPI Measures
		lineageTag: e1520d1c-739c-5881-b423-c36a6bf2cd72

	column data_through_date
		dataType: dateTime
		lineageTag: 2ab6cb7f-6caf-5ffc-b16b-fb935baad5c2
		summarizeBy: none
