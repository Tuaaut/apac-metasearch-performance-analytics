		lineageTag: b6f5659c-f2ad-5efb-b629-c17a33417659
		summarizeBy: none
		sourceColumn: powerbi_import_instruction

	partition RefreshMetadata = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("E:\DE-BI-ML-Projects\03-synthetic-generated-data\apac-metasearch-performance-analytics\bi\snapshot\refresh_metadata.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				  Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				  Types = Table.TransformColumnTypes(Headers, {{"data_through_date", type datetime}, {"snapshot_exported_utc", type datetime}, {"dataform_workflow_state", type text}, {"dataform_completed_utc", type datetime}, {"dataform_total_actions", Int64.Type}, {"dataform_problem_actions", Int64.Type}, {"dataform_assertion_actions", Int64.Type}, {"dataform_problem_assertions", Int64.Type}, {"powerbi_import_instruction", type text}}, "en-US")
				in
				  Types
