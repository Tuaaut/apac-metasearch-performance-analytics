	partition Campaign = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("E:\DE-BI-ML-Projects\03-synthetic-generated-data\apac-metasearch-performance-analytics\bi\snapshot\gold_campaign_daily.csv"), [Delimiter=",", Columns=21, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				  Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				  Types = Table.TransformColumnTypes(Headers, {{"date", type datetime}, {"market", type text}, {"channel", type text}, {"campaign_id", type text}, {"campaign_name", type text}, {"device_type", type text}, {"impressions", Int64.Type}, {"clicks", Int64.Type}, {"ad_spend", type number}, {"conversions", Int64.Type}, {"sessions", Int64.Type}, {"confirmed_bookings", Int64.Type}, {"booking_value", type number}, {"gross_margin", type number}, {"ctr", type number}, {"cpc", type number}, {"cvr", type number}, {"cpa", type number}, {"roas", type number}, {"margin_roas", type number}, {"contribution_after_ad_spend", type number}}, "en-US")
				in
				  Types
