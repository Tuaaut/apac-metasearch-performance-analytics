table Campaign
	lineageTag: f247f816-6275-5cb8-8542-a8c5254ab012

	measure 'Total Impressions' = SUM(Campaign[impressions])
		formatString: #,0
		displayFolder: KPI Measures
		lineageTag: f4c18cc1-93f3-577a-956e-c1f39b1439b3

	measure 'Total Clicks' = SUM(Campaign[clicks])
		formatString: #,0
		displayFolder: KPI Measures
		lineageTag: 525be877-e184-53c8-abbf-4f53206b4ec2

	measure 'Total Sessions' = SUM(Campaign[sessions])
		formatString: #,0
		displayFolder: KPI Measures
		lineageTag: 7359a914-8aa5-58dd-b131-2a551ed8bf45

	measure 'Bookings' = SUM(Campaign[conversions])
		formatString: #,0
		displayFolder: KPI Measures
		lineageTag: c5f9d34e-aecb-569f-ab08-0f9f89856e4b

	measure 'Spend USD' = SUM(Campaign[ad_spend])
		formatString: $#,0;($#,0)
		displayFolder: KPI Measures
		lineageTag: 09b14979-1b9a-5588-b060-f38825dcda2f

	measure 'Booking Value USD' = SUM(Campaign[booking_value])
		formatString: $#,0;($#,0)
		displayFolder: KPI Measures
		lineageTag: 3d6e16bd-0a31-5c28-be20-a8920f84dc09

	measure 'Gross Margin USD' = SUM(Campaign[gross_margin])
		formatString: $#,0;($#,0)
		displayFolder: KPI Measures
		lineageTag: 6d3802e3-6eb8-54e0-a3c5-d90ce5901ab4

	measure 'Contribution USD' = [Gross Margin USD] - [Spend USD]
		formatString: $#,0;($#,0)
		displayFolder: KPI Measures
		lineageTag: 248ebd91-0e93-5756-9d8c-2191b58d534c

	measure 'CTR %' = DIVIDE([Total Clicks], [Total Impressions])
		formatString: 0.0%
		displayFolder: KPI Measures
		lineageTag: ef24fb1a-7016-5da4-a470-ed57860ed64d

	measure 'Session Rate' = DIVIDE([Total Sessions], [Total Clicks])
		formatString: 0.0%
		displayFolder: KPI Measures
		lineageTag: 727403c7-6612-5e65-9e19-1d50f3f8c4bb

	measure 'CVR %' = DIVIDE([Bookings], [Total Clicks])
		formatString: 0.0%
		displayFolder: KPI Measures
		lineageTag: e0849c76-936c-5b11-a3f2-3fae84140a56

	measure 'CPC USD' = DIVIDE([Spend USD], [Total Clicks])
		formatString: $0.00
		displayFolder: KPI Measures
		lineageTag: c353ef59-d508-5689-8244-54f4d51548c2

	measure 'CPA USD' = DIVIDE([Spend USD], [Bookings])
		formatString: $0.00
		displayFolder: KPI Measures
		lineageTag: 8ad0b788-4a68-50ff-9ee1-c3586f7327a9

	measure 'ROAS Multiple' = DIVIDE([Booking Value USD], [Spend USD])
		formatString: 0.00
		displayFolder: KPI Measures
		lineageTag: b9a05f6b-8304-5ebe-a0b3-e769a65523b4

	measure 'Margin ROAS' = DIVIDE([Gross Margin USD], [Spend USD])
		formatString: 0.00
		displayFolder: KPI Measures
		lineageTag: c3405ba8-2f3e-530f-b480-651ce97aba05

	measure 'Booking per Session %' = DIVIDE([Bookings], [Total Sessions])
		formatString: 0.0%
		displayFolder: KPI Measures
		lineageTag: 94a4aeb5-96ff-5606-8b2e-71cdb7a93fe8

	measure 'Action Status' = IF([Contribution USD] < 0, "INVESTIGATE", "RETAIN / SCALE")
		formatString: @
		displayFolder: KPI Measures
		lineageTag: 4cb0b800-84f2-520e-9b31-26454038eade

	measure 'Import Model Status' = IF(CALCULATE(COUNTROWS(Campaign), REMOVEFILTERS(Campaign)) = 0, "NOT LOADED", "LOADED")
		formatString: @
		displayFolder: KPI Measures
		lineageTag: 6ca4a89d-ea9a-57c1-8128-aa77b9ab24ca

	measure 'Thailand Peer CVR %' = CALCULATE([CVR %], KEEPFILTERS(Campaign[market] = "TH"))
		formatString: 0.0%
		displayFolder: KPI Measures
		lineageTag: f738a073-f36d-581b-b617-ff2d7f691f6c

