table FunnelStage
	lineageTag: a266e40c-e60f-5fef-b2ab-39ff30bbb079

	measure 'Funnel Volume' = SWITCH(SELECTEDVALUE(FunnelStage[stage]), "Impressions", [Total Impressions], "Clicks", [Total Clicks], "Sessions", [Total Sessions], "Confirmed bookings", [Bookings])
		formatString: #,0
		displayFolder: KPI Measures
		lineageTag: e420112f-e069-5656-91a9-a0e5a32c5ff6

	measure 'Funnel Step Rate' = SWITCH(SELECTEDVALUE(FunnelStage[stage]), "Clicks", [CTR %], "Sessions", [Session Rate], "Confirmed bookings", [Booking per Session %])
		formatString: 0.0%
		displayFolder: KPI Measures
		lineageTag: 76b6f8b6-d2a0-5a36-9a9a-ed49d55693b9

	column stage_order
		dataType: int64
		lineageTag: 80f4376d-f6f9-5767-bfb5-29da032c5f0c
		summarizeBy: none
		sourceColumn: stage_order

	column stage
		dataType: string
		lineageTag: 1d9762e0-8c04-502b-9189-1b6707703f51
		summarizeBy: none
		sourceColumn: stage

	partition FunnelStage = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("E:\DE-BI-ML-Projects\03-synthetic-generated-data\apac-metasearch-performance-analytics\bi\snapshot\funnel_stages.csv"), [Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				  Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				  Types = Table.TransformColumnTypes(Headers, {{"stage_order", Int64.Type}, {"stage", type text}}, "en-US")
				in
				  Types
